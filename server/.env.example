PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/dsa-tutor
# Pick ONE provider by filling its key. With no key the app runs in free demo mode.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider when both keys are set (gemini or anthropic)
# TUTOR_PROVIDER=gemini
# Optional: GEMINI_MODEL=gemini-3.8-flash
# Optional: the tutor uses claude-haiku-5-5 by default (cheapest). For smarter hints use:
# ANTHROPIC_MODEL=claude-sonnet-5-5
